# Nacos认证配置
# Nacos用于生成JWT Token的密钥，使用长度大于32字符的字符串，再经过Base64编码
NACOS_AUTH_TOKEN=CHANGE_ME_NACOS_AUTH_TOKEN_BASE64_32_CHARS_MIN

# Nacos Server端之间Inner API的身份标识的Key
NACOS_AUTH_IDENTITY_KEY=CHANGE_ME_NACOS_IDENTITY_KEY

# Nacos Server端之间Inner API的身份标识的Value
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_NACOS_IDENTITY_VALUE

# Nacos运行模式
MODE=standalone

# Local demo only: disable Nacos auth so MCP registry APIs work without account initialization.
NACOS_AUTH_ENABLE=false
NACOS_AUTH_ADMIN_ENABLE=false
NACOS_AUTH_CONSOLE_ENABLE=false

# JVM参数优化
JVM_XMS=512m
JVM_XMX=512m
JVM_XMN=256m
